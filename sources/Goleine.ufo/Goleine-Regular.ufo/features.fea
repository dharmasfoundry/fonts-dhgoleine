  @_s = [s sacute scaron scedilla scircumflex scommaaccent];
  @_z = [z zacute zcaron zdotaccent];
  @_o = [o oacute obreve ocircumflex odieresis oe ograve ohungarumlaut omacron otilde];
  @_c = [Cacute c c_e cacute ccaron ccedilla ccircumflex cdotaccent e e_e e_s eacute ebreve ecaron ecircumflex edieresis edotaccent egrave emacron eogonek];
