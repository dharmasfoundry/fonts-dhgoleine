#> languagesystem
languagesystem DFLT dflt;
languagesystem latn dflt;
languagesystem grek dflt;
#< languagesystem

feature aalt {
# Access All Alternates

#> feature
  feature locl;
  feature sups;
  feature salt;
  feature hist;
  feature case;
#< feature
} aalt;
feature locl {
# Localized Forms

#> feature
  script latn; # Latin
  language MOL; # Moldavian
  sub Scedilla by Scommaaccent;
  sub Tcedilla by Tcommaaccent;
  sub scedilla by scommaaccent;
  sub tcedilla by tcommaaccent;

  language ROM; # Romanian
  sub Scedilla by Scommaaccent;
  sub Tcedilla by Tcommaaccent;
  sub scedilla by scommaaccent;
  sub tcedilla by tcommaaccent;
#< feature
} locl;
feature sups {
# Superscript

#> feature
  sub one by onesuperior;
  sub three by threesuperior;
  sub two by twosuperior;
#< feature
} sups;
feature frac {
# Fractions

#> feature
lookup frac_precomposed {

  sub one slash four by onequarter;
  sub one slash two by onehalf;
  sub three slash four by threequarters;
  sub one fraction four by onequarter;
  sub one fraction two by onehalf;
  sub three fraction four by threequarters;
} frac_precomposed;
#< feature
} frac;
feature ordn {
# Ordinals

#> feature
  sub [zero one two three four five six seven eight nine] [A a]' by ordfeminine;
  sub [zero one two three four five six seven eight nine] [O o]' by ordmasculine;
#< feature
} ordn;
feature salt {
# Stylistic Alternates

#> feature
  sub caron from [caron.salt];
  sub commaaccentcomb from [commaaccentcomb.salt];
  sub l_e from [l_e.001];
  sub ocircumflex from [ocircumflex.001];
#< feature
} salt;
feature dlig {
# Discretionary Ligatures

#> feature
  sub a n by a_n;
  sub a s by a_s;
  sub c e by c_e;
  sub d e by d_e;
  sub e e by e_e;
  sub e s by e_s;
  sub h e by h_e;
  sub i e by i_e;
  sub k e by k_e;
  sub k s by k_s;
  sub l e by l_e;
  sub m e by m_e;
  sub m s by m_s;
  sub n e by n_e;
  sub n s by n_s;
  sub t e by t_e;
  sub u e by u_e;
  sub u n by u_n;
  sub u s by u_s;
#< feature
} dlig;
feature liga {
# Standard Ligatures

#> feature
  sub f f by f_f;
  sub f h by f_h;
  sub f k by f_k;
  sub f t by f_t;
  sub f i by fi;
  sub f l by fl;
  sub longs t by longs_t;
  sub f f i by f_f_i;
  sub f f l by f_f_l;
#< feature
} liga;
feature hist {
# Historical Forms

#> feature
  sub s by longs;
#< feature
} hist;
feature case {
# Case Sensitive Forms

#> feature
  sub acute by acute.case;
  sub breve by breve.case;
  sub caron by caron.case;
  sub circumflex by circumflex.case;
  sub dieresis by dieresis.case;
  sub dotaccent by dotaccent.case;
  sub grave by grave.case;
  sub hungarumlaut by hungarumlaut.case;
  sub macron by macron.case;
  sub ring by ring.case;
  sub tilde by tilde.case;
#< feature
} case;
feature kern {
  @_z1 = [z zacute zcaron zdotaccent];
  @_s1 = [a_s e_s k_s m_s n_s s sacute scaron scedilla scircumflex scommaaccent u_s];
  @_e1 = [c_e d_e e e_e eacute ebreve ecaron ecircumflex edieresis edotaccent egrave emacron eogonek h_e i_e k_e l_e m_e n_e t_e u_e];
  @_c1 = [c ccaron ccedilla ccircumflex cdotaccent];
  @_o1 = [o oacute obreve ocircumflex odieresis ograve ohungarumlaut omacron oslash otilde];
  @_i1 = [dotlessi i iacute icircumflex idieresis igrave];
  @_a1 = [a aacute abreve acircumflex adieresis agrave amacron aogonek aring atilde u uacute ubreve ucircumflex udieresis ugrave uhungarumlaut umacron uogonek uring utilde];
  @_m = [a-myanmar a_n m n nacute napostrophe ncaron ncommaaccent ntilde u-myanmar u_n];
  @_H = [H Hbar Hcircumflex I Iacute Icircumflex Idieresis Igrave M];
